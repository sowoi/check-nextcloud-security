# Example environment file for check-nextcloud-security.
#
# Copy this to /etc/check-nextcloud-security/env and adjust the values,
# then reference it from the systemd unit (see check-nextcloud-security.service)
# or a cron job (see ../cron/check-nextcloud-security.cron).
#
# All options accepted on the command line can also be set here using their
# CNS_ prefixed environment variable name. An explicit CLI flag always wins
# over the environment variable.

# Required: the Nextcloud hostname to scan (not an IP address).
CNS_HOST=nextcloud.example.com

# Optional: HTTP/HTTPS proxy to reach scan.nextcloud.com through.
#CNS_PROXY=http://proxy.example.com:3128

# Optional: trigger a fresh rescan on every run instead of reusing the last
# cached result. Avoid combining this with frequent schedules - see the
# "Rescan" section in README.md.
#CNS_RESCAN=false

# Optional: verbose debug logging.
#CNS_DEBUG=false

# Optional: retry/backoff tuning for transient network errors.
#CNS_RETRIES=2
#CNS_BACKOFF_FACTOR=0.5

# HTTP timeout in seconds for each Scan API call.
#CNS_TIMEOUT=10

# Rating thresholds (0-5, where 5 == A+ and 0 == F). A rating at or below
# the value reports the corresponding state.
#CNS_WARNING=3
#CNS_CRITICAL=1

# Also report missing hardening measures and security headers, raising an
# otherwise OK result to WARNING.
#CNS_CHECK_HARDENING=false

# Optional webhook notification. Unset (the default) disables the feature.
# CNS_WEBHOOK_ON selects the lowest state that notifies: critical, warning,
# unknown or always.
#CNS_WEBHOOK_URL=https://hooks.example.com/nextcloud
#CNS_WEBHOOK_ON=critical
#CNS_WEBHOOK_TIMEOUT=10
# Extra headers for the webhook request, separated by ';'.
#CNS_WEBHOOK_HEADERS=X-Auth-Token: <token>; X-Env: prod

# ---------------------------------------------------------------------------
# Local scanning (optional). The default backend is the public Scan API.
# ---------------------------------------------------------------------------

# Path to a YAML configuration file. Values there are used for every option
# that is not set on the command line or in the environment.
#CNS_CONFIG_FILE=/etc/check-nextcloud-security/config.yml

# 'remote' (default) uses scan.nextcloud.com, 'local' runs the checks in this
# process without contacting any external service.
#CNS_SCAN_BACKEND=local

# Base URL of a self-hosted scanner container speaking the Scan API.
# Setting this implies the remote backend against your own service.
#CNS_SCAN_URL=http://127.0.0.1:8080
#CNS_SCAN_TOKEN=<token>
#CNS_SCAN_TOKEN_FILE=/run/secrets/scan_token

# Run the additional local checks (TLS, exposed files, headers, ...).
#CNS_SCANNER_EXTRA_CHECKS=true
# Warn this many days before the TLS certificate expires.
#CNS_SCANNER_TLS_MIN_DAYS=21
# Extra advisory files / feed for the vulnerability matching.
#CNS_SCANNER_VULNERABILITY_DB=/etc/check-nextcloud-security/advisories.json
#CNS_SCANNER_VULNERABILITY_FEED=https://example.com/nextcloud-advisories.json

# ---------------------------------------------------------------------------
# Update check against the local instance via the serverinfo app.
# ---------------------------------------------------------------------------

# auto (default), api, occ or off.
#CNS_SERVERINFO_MODE=api
#CNS_SERVERINFO_URL=https://nextcloud.example.com
#CNS_SERVERINFO_TOKEN_FILE=/run/secrets/serverinfo_token
#CNS_SERVERINFO_USER=admin
#CNS_SERVERINFO_PASSWORD_FILE=/run/secrets/serverinfo_password
# Command line transport instead of the OCS API.
#CNS_SERVERINFO_OCC_COMMAND=php /var/www/html/occ
#CNS_SERVERINFO_CONTAINER=nextcloud-app

# Raise an otherwise OK result to WARNING when an update is available.
#CNS_UPDATE_WARNING=false

# Disable the update check against the local instance completely.
#CNS_NO_UPDATE_CHECK=true
