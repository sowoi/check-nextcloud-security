# Files that must never end up in the build context.
# The Dockerfile only COPYs what it needs, but a smaller context builds faster
# and rules out leaking local state into an image by accident.

# Secrets and local configuration
secrets/
config/*.yml
config/*.yaml
!config/*.example.yml
check-nextcloud-security.yml
*.env
.env
.env.*

# Version control and CI
.git/
.gitignore
.gitattributes
.github/
.pre-commit-config.yaml

# Virtualenvs and packaging output
.venv/
.venv*/
venv/
env/
dist/
build/
*.egg-info/
*.whl
*.tar.gz
uv.lock

# Generated by `uv export`, not a source file
requirements.txt
requirements-*.txt

# Caches and tooling state
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.nox/
.tox/
.coverage
.coverage.*
htmlcov/
.hypothesis/

# Tests, deployment helpers and docs the image does not need
tests/
scripts/
ansible/
contrib/
noxfile.py
mypy.ini
docker-compose.yml
Dockerfile
.dockerignore
CONTRIBUTING.md
CHANGELOG.md
RELEASE.md

# Editor and OS noise
.idea/
.vscode/
*.swp
.DS_Store
